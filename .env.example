# Copy this file to .env and adjust machine-specific runtime settings.
# Keep dataset paths, checkpoints, run IDs, and experiment parameters in YAML.
# The ${VAR:-default} form preserves one-shot overrides from the parent shell.

POINTERCAD_CONDA_ENV="${POINTERCAD_CONDA_ENV:-pointercad}"
POINTERCAD_CONDA_EXE="${POINTERCAD_CONDA_EXE:-/root/miniconda3/bin/conda}"

HF_HOME="${HF_HOME:-/mnt/afs_01e/mayi-folder/hf-cache}"
POINTERCAD_LOG_ROOT="${POINTERCAD_LOG_ROOT:-./log}"

POINTERCAD_DIST_ENV_SCRIPT="${POINTERCAD_DIST_ENV_SCRIPT:-$HOME/dist_env.sh}"
POINTERCAD_PROXY_ENV_SCRIPT="${POINTERCAD_PROXY_ENV_SCRIPT:-$HOME/proxy.sh}"

PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

# Optional CPU/runtime tuning. Leave unset unless the target machine needs it.
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8

# Do not set CUDA_VISIBLE_DEVICES or GPU counts globally: the same .env is used
# by CPU-only episode/preference builders. GPU launchers detect visible devices.

# Optional distributed overrides. Leave these unset for CPU-only commands and
# when the scheduler or dist_env.sh already provides them.
# MASTER_ADDR=localhost
# MASTER_PORT=32502
# NUM_MACHINES=1
# MACHINE_RANK=0
# GPUS_PER_NODE=8
# NUM_PROCESSES=8
